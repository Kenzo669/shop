# Clé API Claude (obligatoire) : https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Modèle par défaut des agents (optionnel ; réglable agent par agent dans « Consommation »)
# CLAUDE_MODEL=claude-opus-5-5

# Fuseau horaire des automatisations
# TIMEZONE=Europe/Paris

# Envoi réel des mails validés (optionnel) — ex. Gmail : smtp.gmail.com, port 465, mot de passe d'application
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Adresse publique du logiciel (sert au retour de la connexion Google)
APP_URL=http://localhost:3000

# Connexion des comptes Google des clients (Gmail + Agenda) — voir README
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Clé de chiffrement des accès connectés (une longue phrase aléatoire). Générée automatiquement si vide.
APP_SECRET=
