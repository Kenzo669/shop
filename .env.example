# Clé API Claude (obligatoire) : https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Modèle utilisé par les agents (optionnel)
# CLAUDE_MODEL=claude-opus-5-5

# Envoi réel des mails validés (optionnel) — ex. Gmail : smtp.gmail.com, port 465, mot de passe d'application
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
